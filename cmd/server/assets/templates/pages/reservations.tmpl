{{ define "title" }}{{ .Title }}{{ end }}

{{ define "main" }}
<div class="card">
    <div class="card__header">
        <h1>My Reservations</h1>
    </div>
    <div class="card__body">
        <div class="mb-4">
            <a href="/ui/reservations/new" class="btn btn-primary">New Reservation</a>
        </div>
        {{ template "reservation-list" . }}
    </div>
</div>
{{ end }}

{{/*
  The fragment. Its root carries the id hx-target points at, and hx-swap
  is outerHTML, so the block replaces itself. Cancelling a reservation
  re-renders this and nothing else.
*/}}
{{ define "reservation-list" }}
<div id="reservation-list">
    {{ if .Reservations }}
    <table class="table">
        <thead>
            <tr>
                <th>Room</th>
                <th>Check-In</th>
                <th>Check-Out</th>
                <th>Status</th>
                <th>Amount</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{ range .Reservations }}
            <tr>
                <td>{{ .RoomID }}</td>
                <td>{{ .CheckIn }}</td>
                <td>{{ .CheckOut }}</td>
                <td>
                    <span class="badge badge-{{ .StatusClass }}">{{ .Status }}</span>
                </td>
                <td>{{ .TotalAmount }}</td>
                <td>
                    <a href="/ui/reservations/{{ .ID }}" class="btn btn-sm">View</a>
                    {{ if .CanCancel }}
                    {{/*
                      A real form, not a bare button: with htmx absent it POSTs,
                      the handler answers 303, and the browser re-renders the
                      page. htmx enhances that into a fragment swap.
                    */}}
                    <form
                        method="post"
                        action="/ui/reservations/{{ .ID }}/cancel"
                        class="form-inline"
                        hx-post="/ui/reservations/{{ .ID }}/cancel"
                        hx-target="#reservation-list"
                        hx-swap="outerHTML"
                        hx-confirm="Are you sure you want to cancel this reservation?"
                    >
                        <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                    </form>
                    {{ end }}
                </td>
            </tr>
            {{ end }}
        </tbody>
    </table>
    {{ else }}
    <p class="text-muted">You have no reservations yet.</p>
    {{ end }}
</div>
{{ end }}
