<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      htmx-config. history "reload" makes back and forward plain browser loads,
      so they never reach the server carrying htmx headers. The indicator CSS
      stays off: htmx 4 would add it outside every cascade layer.
    -->
    <meta name="htmx-config" content='{"includeIndicatorCSS":false,"history":"reload"}' />
    <!-- PWA support -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="/manifest.json" />
    <!-- Favicons -->
    <link rel="icon" href="/static/img/favicon.ico" />
    <link rel="apple-touch-icon" sizes="192x192" href="/static/img/icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/static/img/icon-512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/static/img/icon-192.png" />
    <meta name="theme-color" content="#ffffff" />
    <!-- Layer 1: Reset / foundation -->
    <link rel="stylesheet" href="/static/css/base.css" />
    <!-- Layer 2: Design tokens -->
    <link rel="stylesheet" href="/static/css/theme.css" />
    <!-- Layer 3: Components / layout -->
    <link rel="stylesheet" href="/static/css/styles.css" />
    <script src="/static/js/htmx.min.js" defer></script>
    <title>{{ template "title" . }}</title>
</head>
<!--
  Every htmx attribute here is load-bearing. htmx 4 inherits an attribute only
  through :inherited, so a bare hx-boost would boost nothing. The hx-status lines
  let a 422 swap (the form flow) without pushing the POST's URL, and keep every
  other 4xx and 5xx off the page, out of history, and out of the tab title.
  No transition:true on the boost: this app has never cross-faded.
-->
<body hx-boost:inherited="true"
      hx-status:422:inherited="push:false"
      hx-status:4xx:inherited="swap:'none transition:false ignoreTitle:true' push:false"
      hx-status:5xx:inherited="swap:'none transition:false ignoreTitle:true' push:false">
    <!-- Header Navigation -->
    <header class="nav">
        <div class="nav__brand">{{ .AppName }}</div>

        <!-- Mobile nav toggle -->
        <input type="checkbox" id="nav-toggle" class="nav__toggle" />
        <label
            for="nav-toggle"
            class="nav__toggle-label"
            aria-label="Toggle navigation"
        >
            <span class="nav__hamburger"></span>
        </label>

        <!-- Navigation links. SessionID is empty when nobody is signed in, so
             one shell serves both the signed-in pages and the login page. -->
        <nav class="nav__links">
            {{ if .SessionID }}
            <a href="/ui/" class="nav__link">Home</a>
            <a href="/ui/reservations" class="nav__link">Reservations</a>
            <a href="/auth/logout/{{ .SessionID }}" class="nav__link">Logout</a>
            {{ else }}
            <a href="/auth/login" class="nav__link">Sign In</a>
            {{ end }}
        </nav>
    </header>

    <div class="container">
        <main>{{ template "main" . }}</main>
    </div>

    <!-- Mobile action bar -->
    <nav class="action-bar" aria-label="Quick actions">
        {{ if .SessionID }}
        <a href="/ui/" class="action-bar__item">Home</a>
        <a href="/ui/reservations" class="action-bar__item">Reservations</a>
        {{ if .ShowNew }}
        <a href="/ui/reservations/new" class="action-bar__item">New</a>
        {{ end }}
        {{ else }}
        <a href="/auth/login" class="action-bar__item">Sign In</a>
        {{ end }}
    </nav>
</body>
</html>
