{{ define "sw" }}// Tombstone service worker.
//
// This app registers no service worker any more (the Content-Security-Policy
// blocks the inline script that used to, and the baseline forbids one). A
// browser that installed the old worker keeps it until a new one replaces it,
// so this is that replacement: it takes over, throws away everything the old
// worker cached, unregisters itself, and reloads the pages it controlled so
// they come from the network again.
//
// It handles no fetch events on purpose. Requests go straight to the network
// while it is still alive. Delete this route once the deprecation window is
// over.
self.addEventListener('install', () => self.skipWaiting());

self.addEventListener('activate', (event) => {
  event.waitUntil((async () => {
    const names = await caches.keys();
    await Promise.all(names.map((name) => caches.delete(name)));
    await self.registration.unregister();
    const windows = await self.clients.matchAll({ type: 'window' });
    for (const client of windows) {
      client.navigate(client.url);
    }
  })());
});
{{ end }}
