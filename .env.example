# ======================================
# Environment Configuration
# ======================================
# Template for local development configuration.
#
# Conventions in this repository:
# - Copy this file to `.env` for your local setup.
# - `.env` is ignored by git (local-only).
# - If you need per-machine overrides, use `.env.local` (also local-only).
#
# `make run` loads this file. Rotate the placeholder secret once before the
# first start (see docs/development-guide.md).
#
# Every variable the binary itself reads is also a flag or is listed by
# `./server -h`, which is the authoritative contract. Flags beat these
# variables, which beat the built-in defaults.
#

# ======================================
# Application Identity
# ======================================
# Human-readable application description
APP_DESCRIPTION="Hotel reservation and payment management system"

# Display name used in UI and logs
APP_NAME="Hotel Booking"

# Short name used for Docker image tags, container names, etc.
# Format: lowercase alphanumeric only (no spaces, special chars)
APP_SHORTNAME="hotel-booking"

# Version reported by the MCP server and by /healthz.
# Leave it unset to use the build version from debug.ReadBuildInfo, which is
# the git tag and cannot drift from the commit that produced the binary.
# APP_VERSION=""

# ======================================
# HTTP Server
# ======================================
# Port the application listens on (default: 8080)
# Note: docker-compose.yml maps 8080 on container to 8080 on localhost
PORT=8080

# Bind address (default: empty, meaning every interface)
# Empty is what the container needs, because the proxy is outside it.
# A bare-metal deployment behind a proxy sets 127.0.0.1.
HOST=""

# Redirect URL after successful authentication
# Must match OIDC provider's allowed redirect URI
REDIRECT_URL="http://localhost:8080/ui"

# ======================================
# Kafka - Event Streaming
# ======================================
# Comma-separated list of Kafka broker addresses
# Format: host1:port,host2:port
#
# Use `kafka:9092` when the app runs inside compose, `localhost:9092` when you
# run the server on the host with `make run`.
KAFKA_BROKERS="localhost:9092"

# Consumer group ID for event subscribers
# Kafka uses this to manage partition offsets
KAFKA_CONSUMER_GROUP_ID="test-group"

# ======================================
# MCP (Model Context Protocol) Authentication
# ======================================
# OAuth 2.1 authentication for the /mcp endpoint (AI tool integration)
# Requires a separate Keycloak client configured for machine-to-machine auth

# Client ID for MCP Bearer token validation
# Must be registered in Keycloak with service account enabled
MCP_CLIENT_ID="hotel-booking-mcp"

# ======================================
# OIDC / OpenID Connect - Authentication
# ======================================
# Note: Keycloak provides the OIDC provider in docker-compose.yml
# Admin console: http://127.0.0.1:8180/admin (admin:admin)

# Client ID registered in Keycloak realm
# Must match keycloak/local-realm.json configuration
OIDC_CLIENT_ID="hotel-booking"

# Client secret for OIDC flow
# Development workflow:
# - Keep the placeholder value `CHANGE_ME_LOCAL_SECRET`.
# - Rotate it once before the first start (docs/development-guide.md).
# - Do NOT commit real secrets to version control.
OIDC_CLIENT_SECRET="CHANGE_ME_LOCAL_SECRET"

# Keycloak realm issuer URL
# Format: http(s)://host:port/realms/{realm-name}
#
# IMPORTANT - One issuer URL for browser + app:
# OIDC issuer URLs are strict: the URL configured in the app MUST match the issuer
# returned by Keycloak's discovery document.
#
# This template standardizes on a single issuer URL that works for both:
# - Browsers on the host:              http://localhost:8180/...
# - App running inside Docker:         http://localhost:8180/...
#
# This is achieved via docker-compose.yml using:
#   app.extra_hosts: ["localhost:host-gateway"]
# which makes `localhost` inside the container resolve to the host gateway.
OIDC_ISSUER="http://localhost:8180/realms/local"

# Callback URL after Keycloak authentication
# Must match OIDC_CLIENT_ID's redirect URI in Keycloak
OIDC_REDIRECT_URL="http://localhost:8080/auth/callback"

# ======================================
# Secrets
# ======================================
# Secrets are files, one per secret, never environment variables: a file is not
# inherited by every child process and does not show up in a process listing.
#
# CREDENTIALS_DIRECTORY names the directory holding them. `make run` on the host
# reads ./secrets; docker-compose.yml overrides this with /run/secrets, where it
# mounts the same two files. Create them once:
#
#   for f in secrets/*.example; do cp "$f" "${f%.example}"; done
#
# The files are `reservation-db-password` and `payment-db-password`, named after
# what cmd/server/config.go asks for.
CREDENTIALS_DIRECTORY="./secrets"

# ======================================
# PostgreSQL - Payment Database
# ======================================
# Configuration for the Payment bounded context database
# Used for payments and payment_attempts tables

# Database host (use 'postgres-payment' when running in docker-compose)
PAYMENT_DB_HOST="localhost"

# Database port (different from reservation DB)
PAYMENT_DB_PORT="5433"

# Database user (must match docker-compose.yml)
PAYMENT_DB_USER="payment"

# Database password: the file secrets/payment-db-password, not a variable here.
# See the Secrets section above.
#
# PAYMENT_DB_PASSWORD is still read when CREDENTIALS_DIRECTORY is unset. It is a
# last-resort fallback for a developer's own machine, not how anything in this
# repository supplies the password, so it is left unset on purpose.

# Database name (must match docker-compose.yml)
PAYMENT_DB_NAME="payment_db"

# SSL mode (disable for local development)
PAYMENT_DB_SSLMODE="disable"

# ======================================
# PostgreSQL - Reservation Database
# ======================================
# Configuration for the Reservation bounded context database
# Used for reservations and reservation_guests tables

# Database host (use 'postgres-reservation' when running in docker-compose)
RESERVATION_DB_HOST="localhost"

# Database port
RESERVATION_DB_PORT="5432"

# Database user (must match docker-compose.yml)
RESERVATION_DB_USER="reservation"

# Database password: the file secrets/reservation-db-password, not a variable
# here — see PAYMENT_DB_PASSWORD above for why the variable stays unset.

# Database name (must match docker-compose.yml)
RESERVATION_DB_NAME="reservation_db"

# SSL mode (disable for local development)
RESERVATION_DB_SSLMODE="disable"

# ======================================
# HTTP Server Timeouts
# ======================================
# Not configurable. The four timeouts are constants in cmd/server/main.go at the
# baseline's values: read header 5s, read 10s, write 30s, idle 2m. The old
# SERVER_*_TIMEOUT variables are gone; their 5s write timeout was below what a
# slow response needs.

# ======================================
# Resilience & Stability (cloud-native-utils)
# ======================================
# Thresholds and parameters for fault tolerance and graceful degradation

# Circuit breaker: number of failures before opening circuit
# Open circuit = fast-fail without attempting request
SERVICE_BREAKER_THRESHOLD="5"

# Rate limiting: maximum events per second to process
# Excess events are debounced (dropped or batched)
SERVICE_DEBOUNCE_PER_SEC="10"

# Retry mechanism: delay between retry attempts
# Used for transient failures (network timeouts, 5xx errors)
SERVICE_RETRY_DELAY="5s"

# Retry mechanism: maximum number of attempts
# Total time: SERVICE_RETRY_MAX * SERVICE_RETRY_DELAY (up to 15 seconds here)
SERVICE_RETRY_MAX="3"

# Service call timeout: max time for external calls
# Prevents indefinite hangs on slow dependencies
SERVICE_TIMEOUT="5s"
